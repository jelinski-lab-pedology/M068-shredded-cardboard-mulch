TukeyHSD(aov)
AIC(aov)
plot(aov)
# 2023: all 0
kruskal.test(unmarketable_g ~ treatment, data = yield_23_DB)
kruskal.test(total_g ~ treatment, data = yield_23_DB)
dunnTest(total_g ~ treatment, data = yield_23_DB)
kruskal.test(total_g ~ treatment, data = yield_24_DB)
